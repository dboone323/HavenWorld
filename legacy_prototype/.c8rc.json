{
  "include": [
    "src/server/**/*.ts",
    "src/shared/**/*.ts"
  ],
  "exclude": [
    "src/public/**",
    "tests/**",
    "scripts/**",
    "node_modules/**"
  ],
  "sourceMap": false,
  "check-coverage": true,
  "lines": 70,
  "functions": 70,
  "branches": 60,
  "reports": ["text", "text-summary"]
}
