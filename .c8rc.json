{
  "include": [
    "src/server/**/*.js",
    "src/shared/**/*.mjs",
    "src/shared/**/*.js"
  ],
  "exclude": [
    "src/public/**",
    "src/server/server.js",
    "src/server/__smoke.mjs",
    "tests/**",
    "scripts/**",
    "node_modules/**"
  ],
  "sourceMap": false,
  "check-coverage": true,
  "lines": 80,
  "functions": 75,
  "branches": 60,
  "reports": ["text", "text-summary"]
}
