# /etc/fail2ban/jail.local — HavenWorld hardened fail2ban configuration

[DEFAULT]
bantime = 3600
findtime = 600
maxretry = 5
banaction = iptables-multiport

[sshd]
enabled = true
port = 2222
filter = sshd
logpath = /var/log/auth.log
maxretry = 5
bantime = 3600
findtime = 600

[nginx-http-auth]
enabled = true
port = http,https
filter = nginx-http-auth
logpath = /var/log/nginx/error.log
maxretry = 5

[nginx-limit-req]
enabled = true
port = http,https
filter = nginx-limit-req
logpath = /var/log/nginx/error.log
maxretry = 10
bantime = 7200
findtime = 600

[havenworld-auth]
enabled = true
port = http,https
filter = havenworld-auth
logpath = /var/log/nginx/access.log
maxretry = 10
findtime = 600
bantime = 3600
