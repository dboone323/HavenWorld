{
  "name": "havenworld",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm --filter '@havenworld/shared' build && pnpm --filter './apps/*' build",
    "test": "pnpm --filter './apps/*' test",
    "test:client": "pnpm --filter client test",
    "test:client:coverage": "pnpm --filter client test:coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:perf": "playwright test e2e/performance/ --project=chromium",
    "test:mobile": "playwright test e2e/mobile/ --project=mobile-chrome --project=mobile-safari",
    "test:e2e:report": "playwright show-report playwright-report",
    "lint": "pnpm --filter './apps/*' lint",
    "check-licenses": "license-checker --onlyAllow 'MIT;ISC;Apache-2.0;BSD-2-Clause;BSD-3-Clause;CC0-1.0;0BSD'"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "license-checker": "^25.0.1"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": ">=8.0.0",
      "handlebars": ">=4.7.10",
      "body-parser": ">=2.4.0",
      "ip-address": ">=10.7.4",
      "vite": "~6.4.4",
      "vitest": "~4.1.12",
      "@vitest/mocker": "~4.1.12",
      "@vitest/coverage-v8": "~4.1.12"
    }
  }
}
