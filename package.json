{
  "name": "havenworld",
  "version": "0.1.0",
  "description": "Cozy social virtual world hybrid of MegaPlanet and YoWorld",
  "main": "src/server/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server/server.js",
    "dev": "node --watch src/server/server.js",
    "lint": "node --check src/server/server.js && node --check src/server/db.js && node --check src/server/rooms.js && node --check src/server/moderation.js && node --check src/server/protocol.js",
    "test": "node --test && node tests/integration-runner.mjs",
    "test:watch": "node --test --watch",
    "test:coverage": "c8 node --test && c8 node tests/integration-runner.mjs",
    "test:integration": "node tests/integration-runner.mjs",
    "ci": "npm run test:coverage",
    "pack:web": "vite build",
    "dev:web": "vite",
    "pack:desktop": "electron .",
    "cap": "cap"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "ws": "^8.18.0"
  },
  "keywords": [
    "virtual-world",
    "social-mmo",
    "yoworld",
    "megaplanet",
    "miniplanet",
    "cozy-games",
    "websockets",
    "html5-canvas",
    "supabase",
    "cloudflare"
  ],
  "author": "Daniel Stevens",
  "license": "MIT",
  "devDependencies": {
    "c8": "^12.0.0",
    "electron": "^32.0.0",
    "electron-builder": "^26.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "vite": "^5.0.0"
  },
  "build": {
    "appId": "com.havenworld.app",
    "productName": "HavenWorld",
    "directories": { "output": "dist" },
    "files": [
      "src/**/*",
      "package.json",
      "capacitor.config.json"
    ],
    "extraMetadata": { "main": "src/server/server.js" }
  }
}
