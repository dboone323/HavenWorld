# .env.test — Test environment variables for HavenWorld
# Points to the ISOLATED test database — never havenworld_prod
DATABASE_URL="postgresql://postgres:devpassword123@127.0.0.1:5432/havenworld_test"

# Separate JWT secrets for tests
JWT_SECRET="test_jwt_secret_not_for_production_use_only"
JWT_ACCESS_SECRET="test_jwt_secret_not_for_production_use_only"
JWT_REFRESH_SECRET="test_refresh_secret_not_for_production_use_only"
JWT_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Redis for rate limiter / doorbell tests (DB index 1 isolates test data)
REDIS_URL="redis://127.0.0.1:6379/1"

# No email provider in automated tests. Registration/verification behavior is exercised
# through the test-only verification route; production Resend is never contacted.
EMAIL_FROM="test@havenworld.local"

# App
NODE_ENV="test"
PORT=3000
LOG_LEVEL="error"
# Alpha invite gate. Kept in sync with the deployed server, which currently allows open
# registration. The gate itself is covered by __tests__/integration/auth.integration.test.ts,
# which turns ALPHA_INVITE_ONLY on for its own cases, so E2E does not need it on to exercise
# invite handling. Flip this to "true" (and seed a code) if production closes the gate.
ALPHA_INVITE_ONLY="false"
