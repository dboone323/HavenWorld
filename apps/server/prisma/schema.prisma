generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLAYER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  MUTED
  BANNED
}

enum ItemCategory {
  HAIR
  EYES
  CLOTHING_HEAD
  CLOTHING_FACE
  CLOTHING_BODY
  CLOTHING_LEGS
  CLOTHING_FEET
  CLOTHING_BACK
  CLOTHING_HAND
  FURNITURE
  DECORATION
}

enum ItemRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

enum FriendStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum ReportReason {
  HARASSMENT
  SPAM
  INAPPROPRIATE_CONTENT
  IMPERSONATION
  CHEATING
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWED
  RESOLVED
  DISMISSED
}

enum RoomPrivacy {
  PUBLIC
  FRIENDS_ONLY
  PASSWORD_PROTECTED
  LOCKED
}

enum TradeStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum PetType {
  CAT
  DOG
  BABY_DRAGON
}

enum PetState {
  IDLE
  WANDER
  FOLLOW
  SLEEP
  REACT
}

enum ClubRole {
  OWNER
  OFFICER
  MEMBER
}

enum ListingStatus {
  ACTIVE
  SOLD
  CANCELLED
}

model User {
  id               String       @id @default(uuid())
  username         String       @unique
  email            String       @unique
  passwordHash     String
  role             Role         @default(PLAYER)
  status           UserStatus   @default(ACTIVE)
  emailVerified    Boolean      @default(false)
  emailVerifyToken String?
  mutedUntil       DateTime?
  createdAt        DateTime     @default(now())
  lastLoginAt      DateTime?

  // Phase 3 Economy & Prestige
  havenCoins       Int          @default(100)
  havenGems        Int          @default(0)
  isVIP            Boolean      @default(false)
  vipSince         DateTime?

  // Existing Relations
  avatar           Avatar?
  inventory        Inventory[]
  ownedRooms       Room[]       @relation("RoomOwner")
  placedFurniture  RoomFurniture[]
  sentMessages     ChatMessage[]
  sentDirectMessages     DirectMessage[] @relation("DMSent")
  receivedDirectMessages DirectMessage[] @relation("DMReceived")
  sentReports      Report[]     @relation("Reporter")
  receivedReports  Report[]     @relation("Reported")
  initiatedFriends Friend[]     @relation("Requester")
  receivedFriends  Friend[]     @relation("Addressee")
  createdInviteCodes InviteCode[] @relation("InviteCreator")
  usedInviteCode   InviteCode?  @relation("InviteUser")

  // Phase 3 Relations
  fishCatches        FishCatch[]
  fishingLeaderboard FishingLeaderboard[]
  roomDecorators     RoomDecorator[]
  guestbookEntries   GuestbookEntry[]
  tipsSent           TipTransaction[]     @relation("TipSender")
  tipsReceived       TipTransaction[]     @relation("TipReceiver")
  tradesInitiated    TradeLog[]           @relation("TradeInitiator")
  tradesReceived     TradeLog[]           @relation("TradeReceiver")
  loginStreak        DailyLoginStreak?
  giftsSent          GiftTransaction[]    @relation("GiftSender")
  giftsReceived      GiftTransaction[]    @relation("GiftReceiver")
  pets               Pet[]
  minigameSessions   MinigameSession[]
  weeklyEarningsCaps WeeklyEarningsCap[]
  materialInventory  MaterialInventory?
  craftingQueues     CraftingQueue[]
  achievements       Achievement[]
  passportFrame      PassportFrame?
  seasonalProgress   SeasonalProgress[]
  clubsOwned         Club[]               @relation("ClubOwner")
  clubMembership     ClubMember?
  dailyQuests        DailyQuestProgress[]
  photos             GalleryPhoto[]
  photoLikes         PhotoLike[]

  // Part 8 Security Hardening
  isBanned           Boolean              @default(false)
  bannedAt           DateTime?
  weeklyEarnings     Int                  @default(0)
  refreshTokens      RefreshToken[]
  adminAuditLogs     AdminAuditLog[]      @relation("AdminAuditAdmin")
  transactionsSent   TransactionLog[]     @relation("TransactionSender")
  transactionsReceived TransactionLog[]   @relation("TransactionReceiver")
  loftAccesses       LoftAccess[]

  // Part 9B Onboarding (tutorial + welcome badge)
  tutorialCompleted  Boolean              @default(false)
  tutorialStep       Int                  @default(0)
  welcomeBadgeAt     DateTime?
  sessionId          String?

  // Part 9B Analytics
  gameEvents         GameEvent[]

  // Track 4.6 Marketplace
  marketplaceListings MarketplaceListing[] @relation("MarketplaceSeller")

  @@map("users")
}

model Avatar {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bodyType    String   @default("default")
  skinTone    String   @default("light")
  hairStyle   String   @default("hair-short-01")
  hairColor   String   @default("brown")
  eyeStyle    String   @default("eyes-default")
  eyeColor    String   @default("brown")
  outfitHead  String?
  outfitFace  String?
  outfitBody  String?
  outfitLegs  String?
  outfitFeet  String?
  outfitBack  String?
  outfitHand  String?
  bodyTypeVal Float    @default(0.5)
  heightVal   Float    @default(0.5)
  buildVal    Float    @default(0.5)
  /** 'male' | 'female' | 'unspecified' — set in the wardrobe customizer. */
  gender      String   @default("unspecified")
  topColor    String   @default("#4169E1")
  bottomColor String   @default("#2E8B57")
  updatedAt   DateTime @updatedAt

  @@map("avatars")
}

model Item {
  id            String        @id @default(uuid())
  name          String        @unique
  description   String        @default("")
  category      ItemCategory
  rarity        ItemRarity    @default(COMMON)
  isTradeable   Boolean       @default(false)
  isDefault     Boolean       @default(false)
  price         Int           @default(0)
  spriteKey     String
  assetUrl      String?
  createdAt     DateTime      @default(now())
  inventories   Inventory[]
  roomFurniture RoomFurniture[]
  marketplaceListings MarketplaceListing[]

  @@map("items")
}

model Inventory {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id])
  quantity   Int      @default(1)
  acquiredAt DateTime @default(now())
  isEquipped Boolean  @default(false)

  @@unique([userId, itemId])
  @@map("inventories")
}

model Room {
  id            String          @id @default(uuid())
  name          String
  description   String          @default("")
  ownerId       String?
  owner         User?           @relation("RoomOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  isPublic      Boolean         @default(false)
  maxOccupants  Int             @default(50)
  theme         String          @default("default")
  width         Int             @default(20)
  height        Int             @default(15)
  backgroundKey String          @default("map-lobby")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  privacy       RoomPrivacy     @default(PUBLIC)
  passwordHash  String?
  awayMessage   String?
  moodPreset    String          @default("day")
  floorTexture  String?         @default("floor-wood-oak")
  wallTexture   String?         @default("wall-plaster-white")

  // Existing Relations
  furniture     RoomFurniture[]
  chatMessages  ChatMessage[]

  // Phase 3 Relations
  decorators       RoomDecorator[]
  accessLogs       RoomAccessLog[]
  guestbookEntries GuestbookEntry[]
  club             Club?

  // Part 8 Security Hardening
  accessMode       String          @default("PUBLIC")
  isActive         Boolean         @default(true)
  loftAccesses     LoftAccess[]

  // Part 9B Onboarding — Welcome Island solo tutorial room
  isTutorial       Boolean         @default(false)
  isSolo           Boolean         @default(false)

  @@map("rooms")
}

model RoomFurniture {
  id        String   @id @default(uuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id])
  placedBy  String
  placer    User     @relation(fields: [placedBy], references: [id])
  x         Float
  y         Float
  z         Float    @default(0)
  rotation  Float    @default(0)
  scaleX    Float    @default(1)
  scaleY    Float    @default(1)
  scaleZ    Float    @default(1)
  layer     Int      @default(0)
  placedAt  DateTime @default(now())

  @@map("room_furniture")
}

model ChatMessage {
  id         String   @id @default(uuid())
  roomId     String?
  room       Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  senderId   String
  sender     User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content    String
  isFiltered Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([roomId, createdAt])
  @@map("chat_messages")
}

model Friend {
  id          String       @id @default(uuid())
  requesterId String
  requester   User         @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User         @relation("Addressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([requesterId, addresseeId])
  @@map("friends")
}

model DirectMessage {
  id         String   @id @default(uuid())
  senderId   String
  sender     User     @relation("DMSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("DMReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([receiverId, read])
  @@index([senderId, receiverId])
  @@map("direct_messages")
}

model Report {
  id             String       @id @default(uuid())
  reporterId     String
  reporter       User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUserId String
  reportedUser   User         @relation("Reported", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reason         ReportReason
  description    String       @default("")
  status         ReportStatus @default(OPEN)
  moderatorNotes String?
  createdAt      DateTime     @default(now())
  resolvedAt     DateTime?

  @@index([status, createdAt])
  @@map("reports")
}

model InviteCode {
  id        String    @id @default(uuid())
  code      String    @unique
  createdBy String
  creator   User      @relation("InviteCreator", fields: [createdBy], references: [id])
  usedById  String?   @unique
  usedBy    User?     @relation("InviteUser", fields: [usedById], references: [id])
  usedAt    DateTime?
  expiresAt DateTime
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  @@index([code, isActive])
  @@map("invite_codes")
}

// ── Phase 3 Models ──────────────────────────────────────────────────────────

// §1 Fishing
model FishCatch {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  species     String
  weightLbs   Float
  coinsEarned Int
  caughtAt    DateTime @default(now())

  @@index([userId, caughtAt])
  @@map("fish_catches")
}

model FishingLeaderboard {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  species   String
  weightLbs Float
  weekOf    DateTime

  @@unique([userId, weekOf])
  @@index([weekOf, weightLbs])
  @@map("fishing_leaderboards")
}

// §2 Loft Privacy & Doorbell
model RoomDecorator {
  id        String   @id @default(uuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedAt DateTime @default(now())

  @@unique([roomId, userId])
  @@map("room_decorators")
}

model RoomAccessLog {
  id        String   @id @default(uuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  visitorId String
  visitedAt DateTime @default(now())

  @@index([roomId, visitedAt])
  @@map("room_access_logs")
}

// §3 Guestbook & Tip Jar
model GuestbookEntry {
  id           String   @id @default(uuid())
  roomId       String
  room         Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  authorId     String
  author       User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorName   String
  authorAvatar String?
  message      String   @db.VarChar(120)
  createdAt    DateTime @default(now())

  @@index([roomId, createdAt])
  @@map("guestbook_entries")
}

model TipTransaction {
  id         String   @id @default(uuid())
  senderId   String
  sender     User     @relation("TipSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("TipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  amount     Int
  roomId     String
  createdAt  DateTime @default(now())

  @@index([receiverId, createdAt])
  @@map("tip_transactions")
}

// §5 Anti-Scam P2P Trading
model TradeLog {
  id             String      @id @default(uuid())
  initiatorId    String
  initiator      User        @relation("TradeInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  receiverId     String
  receiver       User        @relation("TradeReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  initiatorItems Json
  receiverItems  Json
  initiatorCoins Int         @default(0)
  receiverCoins  Int         @default(0)
  status         TradeStatus
  createdAt      DateTime    @default(now())
  completedAt    DateTime?

  @@index([initiatorId, createdAt])
  @@index([receiverId, createdAt])
  @@map("trade_logs")
}

// §6 Dual-Currency Economy
model DailyLoginStreak {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  lastLoginDate DateTime

  @@map("daily_login_streaks")
}

model GiftTransaction {
  id         String   @id @default(uuid())
  senderId   String
  sender     User     @relation("GiftSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("GiftReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  itemId     String
  message    String?  @db.VarChar(140)
  createdAt  DateTime @default(now())

  @@index([receiverId, createdAt])
  @@map("gift_transactions")
}

// §7 Pet Companions
model Pet {
  id           String    @id @default(uuid())
  ownerId      String
  owner        User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  petType      PetType
  name         String    @db.VarChar(16)
  happiness    Int       @default(100)
  hunger       Int       @default(100)
  accessoryIds Json      @default("[]")
  lastFedAt    DateTime  @default(now())
  createdAt    DateTime  @default(now())

  @@index([ownerId])
  @@map("pets")
}

// §8 Pizza Chef
model MinigameSession {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameType    String
  coinsEarned Int
  score       Int
  duration    Int
  completedAt DateTime @default(now())

  @@index([userId, gameType, completedAt])
  @@map("minigame_sessions")
}

model WeeklyEarningsCap {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameType String
  earned   Int      @default(0)
  weekOf   DateTime

  @@unique([userId, gameType, weekOf])
  @@map("weekly_earnings_caps")
}

// §9 Workshop Crafting
model MaterialInventory {
  id           String @id @default(uuid())
  userId       String @unique
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  scrapMetal   Int    @default(0)
  timber       Int    @default(0)
  fabric       Int    @default(0)
  crystalShard Int    @default(0)

  @@map("material_inventories")
}

model CraftingQueue {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId    String
  startedAt   DateTime @default(now())
  completesAt DateTime
  claimed     Boolean  @default(false)
  // Set by the every-5-minutes completion cron so a craft is announced exactly once.
  notifiedAt  DateTime?

  @@index([userId, claimed])
  @@map("crafting_queues")
}

// §10 Passport & Achievements
model Achievement {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stamp    String
  earnedAt DateTime @default(now())

  @@unique([userId, stamp])
  @@map("achievements")
}

model PassportFrame {
  id      String @id @default(uuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  frameId String @default("default")

  @@map("passport_frames")
}

// §12 Seasonal Events
model SeasonalEvent {
  id        String             @id @default(uuid())
  name      String
  theme     String
  startsAt  DateTime
  endsAt    DateTime
  isActive  Boolean            @default(false)
  rewards   Json
  progress  SeasonalProgress[]

  @@map("seasonal_events")
}

model SeasonalProgress {
  id       String        @id @default(uuid())
  userId   String
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId  String
  event    SeasonalEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tier     Int           @default(0)
  currency Int           @default(0)

  @@unique([userId, eventId])
  @@map("seasonal_progress")
}

// §13 Clubs
model Club {
  id        String       @id @default(uuid())
  name      String       @unique @db.VarChar(24)
  motto     String?      @db.VarChar(80)
  tag       String?      @db.VarChar(5)
  ownerId   String
  owner     User         @relation("ClubOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  roomId    String?      @unique
  room      Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())
  members   ClubMember[]

  @@map("clubs")
}

model ClubMember {
  id       String   @id @default(uuid())
  clubId   String
  club     Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId   String   @unique
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     ClubRole @default(MEMBER)
  joinedAt DateTime @default(now())

  @@map("club_members")
}

// §15 Daily Quests
model DailyQuestProgress {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId     String
  progress    Int      @default(0)
  goal        Int
  completed   Boolean  @default(false)
  rewardCoins Int
  rewardGems  Int      @default(0)
  questDate   DateTime

  @@unique([userId, questId, questDate])
  @@map("daily_quest_progress")
}

// §16 Photo Gallery
model GalleryPhoto {
  id             String      @id @default(uuid())
  authorId       String
  author         User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  imageUrl       String
  caption        String?     @db.VarChar(80)
  likes          Int         @default(0)
  roomName       String
  perceptualHash String?
  createdAt      DateTime    @default(now())
  photoLikes     PhotoLike[]

  @@index([createdAt])
  @@index([likes])
  @@map("gallery_photos")
}

model PhotoLike {
  id      String       @id @default(uuid())
  photoId String
  photo   GalleryPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)
  userId  String
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([photoId, userId])
  @@map("photo_likes")
}

// ── Part 8 Security Hardening Models ──────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@index([familyId])
  @@map("refresh_tokens")
}

model AdminAuditLog {
  id        String   @id @default(uuid())
  adminId   String
  admin     User     @relation("AdminAuditAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  action    String
  targetId  String?
  metadata  String?
  ip        String   @default("unknown")
  userAgent String   @default("unknown")
  timestamp DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@map("admin_audit_logs")
}

model TransactionLog {
  id         String   @id @default(uuid())
  senderId   String?
  sender     User?    @relation("TransactionSender", fields: [senderId], references: [id])
  receiverId String
  receiver   User     @relation("TransactionReceiver", fields: [receiverId], references: [id])
  amount     Int
  type       String
  source     String?
  timestamp  DateTime @default(now())

  @@index([receiverId])
  @@index([senderId])
  @@map("transaction_logs")
}

// ── Part 9B: Product Analytics ────────────────────────────────────────────────
/// Append-only gameplay telemetry written by AnalyticsService.trackEvent().
/// Fire-and-forget: a failed insert must never break a player-facing request.
model GameEvent {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Logical event name, e.g. PLAYER_JOIN_WORLD, FISH_CAUGHT, CHAT_MESSAGE.
  event     String
  /// Session identifier shared with the JWT so session length is derivable.
  sessionId String?
  roomId    String?
  payload   Json?
  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@index([userId, createdAt])
  @@index([sessionId])
  @@map("game_events")
}

model LoftAccess {
  id        String   @id @default(uuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([roomId, userId])
  @@map("loft_access")
}

model MarketplaceListing {
  id          String        @id @default(uuid())
  sellerId    String
  seller      User          @relation("MarketplaceSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item          @relation(fields: [itemId], references: [id])
  priceCoins  Int
  status      ListingStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  purchasedAt DateTime?
  buyerId     String?

  @@index([status, createdAt])
  @@index([sellerId])
  @@map("marketplace_listings")
}


