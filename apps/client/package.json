{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate_assets.mjs && node scripts/generate_icons.mjs && node scripts/copy-havok.cjs",
    "build": "vite build",
    "test": "vitest run --config vitest.config.ts",
    "test:client": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:scene": "vitest run --config vitest.config.ts --reporter=verbose __tests__/scene",
    "lint": "tsc --noEmit -p tsconfig.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "@babylonjs/core": "^9.27.1",
    "@babylonjs/gui": "^9.27.1",
    "@babylonjs/havok": "^1.3.14",
    "@babylonjs/loaders": "^9.27.1",
    "@babylonjs/materials": "^9.27.1",
    "@havenworld/shared": "workspace:*",
    "alpinejs": "^3.17.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@babylonjs/inspector": "^9.27.1",
    "@babylonjs/serializers": "^9.27.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.8",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^2.1.8"
  }
}
