# .env.test — test environment config
#
# Port contract for the E2E stack. These MUST agree with the servers Playwright boots
# (playwright.config.ts webServer + .github/workflows/e2e.yml); a mismatch makes the
# browser call a dead port and every register/login appears to hang forever.
#   API server  : 3000
#   Vite client : 5173 (BASE_URL)
# apps/client/src/config.ts reads VITE_SERVER_URL first, VITE_API_URL is its fallback.
VITE_SERVER_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000
VITE_SOCKET_URL=http://localhost:3000
VITE_ENV=test
TEST_INVITE_CODE=HAVEN-TEST-2026
TEST_API_URL=http://localhost:3000
TEST_USER_A_PASS=SecureTestPass_A!2026
TEST_USER_B_PASS=SecureTestPass_B!2026
TEST_API_KEY=test_api_key_secure_2026
