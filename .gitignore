# =============================================================================
# HavenWorld — .gitignore
# =============================================================================

# Environment variables & secrets (CRITICAL: Never commit API secrets or keys)
.env
.env*.local
.env.development
.env.production
*.env
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Node & pnpm dependencies
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local SQLite databases + build artifacts
dist/
release/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
havenworld.db

# Database backups & dumps (never commit database contents)
*.sql.gz
*.sql.bak
*.dump
*.bak
backups/

# Python caches
__pycache__/
*.py[cod]

# Scratch / temp working directories
tmp/
scratch/

# Logs
logs/
*.log

# Test coverage artifacts (c8 / nyc)
coverage/
.nyc_output/

# macOS system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Editor directories
.vscode/
.idea/
*.swp
*.swo

# Supabase CLI temp files
supabase/.temp/

# Test snapshots / artifacts (regenerated on demand)
tests/visual-check.png
screenshots/

# Playwright artifacts (regenerated on every run — never commit traces/videos/HTML)
playwright-report/
test-results/
blob-report/
playwright/.cache/

# Allow Havok Physics WASM in public/
!apps/client/public/HavokPhysics.wasm
!apps/client/public/HavokPhysics.js.wasm
