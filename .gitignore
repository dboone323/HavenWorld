# =============================================================================
# HavenWorld — .gitignore
# =============================================================================

# Environment variables & secrets (CRITICAL: Never commit API secrets or keys)
.env
.env*.local
*.env
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Node & pnpm dependencies
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local SQLite databases + build artifacts
dist/
release/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
havenworld.db

# Logs
logs/
*.log

# Test coverage artifacts (c8 / nyc)
coverage/
.nyc_output/

# macOS system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Editor directories
.vscode/
.idea/
*.swp
*.swo

# Supabase CLI temp files
supabase/.temp/

# Test snapshots / artifacts (regenerated on demand)
tests/visual-check.png
