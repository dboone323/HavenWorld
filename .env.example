# =============================================================================
# HavenWorld — Environment Configuration
# =============================================================================
# Duplicate this file as .env and fill in your actual credentials:
#   cp .env.example .env

# Server Network Port
PORT=3000

# -----------------------------------------------------------------------------
# Supabase Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
# -----------------------------------------------------------------------------
# Your unique project URL (e.g., https://abcdefghijklm.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Public Anon Key (Safe for browser / client-side queries with RLS)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Secret Service Role Key (Keep secret! Used ONLY by Node.js server to bypass RLS)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# Cloudflare Configuration (Optional for production / Tunnel)
# -----------------------------------------------------------------------------
# Your production public domain (if proxying through Cloudflare)
PUBLIC_GAME_URL=https://play.havenworld.game
