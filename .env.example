# =============================================================================
# HavenWorld — Environment Configuration
# =============================================================================
# This root .env.example is a lightweight reference. For full server config,
# see: apps/server/.env.example
# For client config, copy: apps/client/.env.development
#
# This file is tracked in Git and should never contain real secrets.
# =============================================================================

PORT=3000

# Server (In multi-worker PM2 clusters, configure connection_limit to avoid exhausting PostgreSQL max_connections)
DATABASE_URL="postgresql://postgres:***@127.0.0.1:5432/havenworld_dev?connection_limit=10&pool_timeout=15"
REDIS_URL="redis://127.0.0.1:6379"
JWT_ACCESS_SECRET="change-me-to-64-hex-chars"
JWT_REFRESH_SECRET="change-me-to-64-hex-chars"
CLIENT_URL="https://havenworld-game.pages.dev"
NODE_ENV="development"

# Production public URL (Cloudflare Tunnel)
PUBLIC_GAME_URL=https://havenworld-game.pages.dev
